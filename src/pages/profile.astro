---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { url } from '../lib/url';
---

<BaseLayout title="Profile" current="profile" description={`About ${profile.name}: education, skills and CV.`}>
  <section class="profile-head">
    {
      profile.photo ? (
        <img class="avatar" src={url(profile.photo)} alt={`Photo of ${profile.name}`} width="160" height="160" />
      ) : (
        <div class="avatar placeholder" style="width:160px;height:160px" aria-hidden="true">[ Photo ]</div>
      )
    }
    <div class="profile-id">
      <h1 class="page-title">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      <p class="place">{profile.location}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href={url(profile.cv)} download>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3v12M7 10l5 5 5-5M5 21h14"></path>
        </svg>
        Download CV
      </a>
      <a class="btn" href="#contact">Contact</a>
    </div>
  </section>

  <section class="row" aria-labelledby="about-h">
    <h2 id="about-h">About me</h2>
    <div class="row-body about">
      {profile.about.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="row" aria-labelledby="edu-h">
    <h2 id="edu-h">Education</h2>
    <div class="row-body">
      {
        profile.education.map((e) => (
          <div class="timeline-item">
            <div>
              <p class="title">{e.title}</p>
              <p class="place">{e.place}</p>
            </div>
            <span class="period">{e.period}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="row" aria-labelledby="exp-h">
    <h2 id="exp-h">Experience</h2>
    <div class="row-body">
      {
        profile.experience.map((e) => (
          <div class="timeline-item">
            <div>
              <p class="title">{e.title}</p>
              <p class="place">{e.place}</p>
              {e.description && <p class="desc">{e.description}</p>}
            </div>
            <span class="period">{e.period}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="row" aria-labelledby="skills-h">
    <h2 id="skills-h">Skills</h2>
    <dl class="row-body facts-grid">
      {
        profile.skills.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="row" aria-labelledby="gaming-h">
    <h2 id="gaming-h">Gaming</h2>
    <dl class="row-body facts-grid">
      {
        profile.gaming.map((g) => (
          <div>
            <dt>{g.label}</dt>
            <dd>{g.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="row" id="contact" aria-labelledby="contact-h" style="padding-bottom:96px">
    <h2 id="contact-h">Contact</h2>
    <div class="row-body contact-grid">
      <a class="tile" href={`mailto:${profile.email}`}>
        <span class="label">Email</span>
        <span class="value">{profile.email}</span>
      </a>
      {
        profile.links.map((l) => (
          <a class="tile" href={l.href} target="_blank" rel="noopener noreferrer">
            <span class="label">{l.label}</span>
            <span class="value">{l.handle}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
